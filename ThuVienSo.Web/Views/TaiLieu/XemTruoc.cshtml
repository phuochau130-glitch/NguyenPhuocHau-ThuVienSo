@model XemTruocSachViewModel
@{
    ViewData["Title"] = "Xem trước tài liệu";
    var dinhDangTep = (Model.DinhDangTepXemTruoc ?? "PDF").ToUpperInvariant();
    var laWord = dinhDangTep == "DOCX";
    var hoTroXemTep = dinhDangTep is "PDF" or "DOCX";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Tra cứu tài liệu</a></li>
        <li class="breadcrumb-item"><a asp-action="ChiTiet" asp-route-id="@Model.TaiLieu.MaTaiLieu">@Model.TaiLieu.TenTaiLieu</a></li>
        <li class="breadcrumb-item active">Xem trước</li>
    </ol>
</nav>

@if (!string.IsNullOrWhiteSpace(Model.UrlTepXemTruoc) && hoTroXemTep)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Nội dung đọc thử (@dinhDangTep) · đã khóa 1 nửa</span>
            <a class="btn btn-sm btn-outline-secondary" asp-action="ChiTiet" asp-route-id="@Model.TaiLieu.MaTaiLieu">Quay lại chi tiết</a>
        </div>
        <div class="card-body p-0">
            <div id="xemTruocWrap" style="height: 78vh; min-height: 480px; background:#4b5563;">
                @if (laWord)
                {
                    <div class="docx-scroll" style="height:100%;overflow:auto;padding:1rem;">
                        <div id="docxLoading" class="text-center text-light py-4">
                            <div class="spinner-border spinner-border-sm" role="status"></div>
                            <div class="mt-2">Đang tải nội dung tài liệu Word...</div>
                        </div>
                        <div id="docxContainer"></div>
                    </div>
                }
                else
                {
                    <embed src="@Model.UrlTepXemTruoc#toolbar=1&view=FitH" type="application/pdf"
                           style="width:100%;height:100%;border:none;background:#fff;" />
                }
            </div>
        </div>
        <div class="card-footer bg-warning-subtle d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span class="small text-dark">
                <strong>Đã khóa 1 nửa nội dung:</strong> bản đọc thử chỉ hiển thị khoảng 50% nội dung tài liệu.
            </span>
            <a class="btn btn-sm btn-success" asp-action="ChiTiet" asp-route-id="@Model.TaiLieu.MaTaiLieu">
                Đăng ký mượn để đọc toàn văn
            </a>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(Model.UrlTepXemTruoc))
{
    <div class="alert alert-warning">
        Tệp định dạng .DOC cũ chưa hỗ trợ xem trực tiếp. Vui lòng tải lại bản PDF hoặc DOCX để xem trước.
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <h4>@Model.TaiLieu.TenTaiLieu</h4>
        <p class="text-muted">Thông tin tóm tắt bản in. Bản xem trước chỉ hiển thị một phần nội dung (tối đa @QuyDinh.SoKyTuXemTruoc ký tự) theo nội quy thư viện.</p>

        <pre class="bg-light border rounded p-3" style="white-space: pre-wrap;">@Model.NoiDungXemTruoc</pre>

        @if (Model.BiCatNgan)
        {
            <div class="alert alert-warning mb-3">
                Nội dung đã được rút gọn do giới hạn xem trước. Vui lòng đăng ký mượn sách để đọc toàn văn.
            </div>
        }

        <a class="btn btn-outline-secondary" asp-action="ChiTiet" asp-route-id="@Model.TaiLieu.MaTaiLieu">Quay lại chi tiết</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.UrlTepXemTruoc) && laWord)
{
    @section Scripts {
        <script src="~/lib/docx-preview/jszip.min.js"></script>
        <script src="~/lib/docx-preview/docx-preview.min.js"></script>
        <script>
            (function () {
                var container = document.getElementById('docxContainer');
                if (!container || typeof docx === 'undefined') return;
                var loading = document.getElementById('docxLoading');

                fetch('@Model.UrlTepXemTruoc')
                    .then(function (res) {
                        if (!res.ok) throw new Error('Không tải được tệp tài liệu.');
                        return res.blob();
                    })
                    .then(function (blob) {
                        return docx.renderAsync(blob, container, null, {
                            inWrapper: true,
                            breakPages: true,
                            experimental: true
                        });
                    })
                    .then(function () { if (loading) loading.style.display = 'none'; })
                    .catch(function (err) {
                        if (loading) {
                            loading.innerHTML = '<div class="alert alert-warning m-3">Không hiển thị được nội dung Word: '
                                + (err && err.message ? err.message : 'lỗi không xác định') + '</div>';
                        }
                    });
            })();
        </script>
    }
}
