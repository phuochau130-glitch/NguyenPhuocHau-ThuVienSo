@model DocTaiLieuViewModel
@{
    ViewData["Title"] = "Đọc tài liệu";
    Layout = "_LayoutDoc";

    var tl = Model.TaiLieu;
    var banSo = Model.BanSo;
    var dinhDang = (banSo.DinhDang ?? "PDF").ToUpperInvariant();
    var tenNguoiDung = User.TenHienThi();
    var maTaiLieu = tl.MaTaiLieu;
    var thoiGian = DateTime.Now.ToString("dd/MM/yyyy HH:mm");
}

<style>
    .doc-toolbar {
        background: #fff;
        border: 1px solid #e6e8ef;
        border-radius: .9rem;
        box-shadow: 0 1px 4px rgba(0,0,0,.04);
        padding: .85rem 1.1rem;
        margin-bottom: 1.2rem;
    }
    .btn-quaylai {
        border: 1px solid #d0d5dd;
        background: #fff;
        color: #344054;
        border-radius: .6rem;
        padding: .45rem .9rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }
    .btn-quaylai:hover { background: #f9fafb; color: #1565c0; }
    .btn-daquyen {
        background: #16a34a;
        color: #fff;
        border: none;
        border-radius: .5rem;
        padding: .45rem .9rem;
        font-weight: 600;
    }
    .btn-tailieu {
        background: #dc2626;
        color: #fff;
        border: none;
        border-radius: .5rem;
        padding: .45rem .9rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }
    .btn-tailieu:hover { color: #fff; opacity: .92; }
    .info-card {
        background: #fff;
        border: 1px solid #e6e8ef;
        border-radius: .9rem;
        box-shadow: 0 1px 4px rgba(0,0,0,.04);
        padding: 1.1rem;
    }
    .info-card .info-title {
        font-weight: 700;
        color: #1565c0;
        margin-bottom: .9rem;
        display: flex;
        align-items: center;
        gap: .4rem;
    }
    .info-row {
        display: flex;
        justify-content: space-between;
        padding: .4rem 0;
        border-bottom: 1px dashed #eef0f4;
    }
    .info-row:last-of-type { border-bottom: none; }
    .info-row .label { color: #667085; }
    .info-row .value { font-weight: 600; color: #111827; text-align: right; }
    .info-row .value.gia { color: #1565c0; }
    .info-mota {
        margin-top: .9rem;
        padding-top: .9rem;
        border-top: 1px solid #eef0f4;
        color: #475467;
        font-size: .9rem;
        line-height: 1.55;
    }
    .viewer-wrap {
        position: relative;
        background: #1f2937;
        border-radius: .9rem;
        box-shadow: 0 4px 16px rgba(0,0,0,.12);
        overflow: hidden;
        height: 78vh;
        min-height: 520px;
    }
    .viewer-wrap .viewer-bar {
        background: #111827;
        color: #d1d5db;
        padding: .5rem 1rem;
        display: flex;
        align-items: center;
        gap: .75rem;
        font-size: .85rem;
    }
    .viewer-wrap embed,
    .viewer-wrap iframe {
        width: 100%;
        height: calc(100% - 40px);
        border: none;
        background: #fff;
    }
    .watermark-layer {
        position: absolute;
        inset: 40px 0 0 0;
        pointer-events: none;
        overflow: hidden;
        z-index: 5;
    }
    .docx-scroll {
        height: calc(100% - 40px);
        overflow: auto;
        background: #4b5563;
        padding: 1rem;
    }
    .docx-body .docx-wrapper {
        background: transparent;
        padding: 0;
    }
    .docx-body .docx-wrapper > section.docx-page {
        margin: 0 auto 1rem auto;
        box-shadow: 0 2px 10px rgba(0,0,0,.35);
    }
    .watermark-layer .wm-item {
        position: absolute;
        color: rgba(255,255,255,.18);
        font-size: .8rem;
        font-weight: 600;
        white-space: nowrap;
        transform: rotate(-30deg);
        user-select: none;
    }
</style>

<div class="doc-toolbar d-flex flex-wrap align-items-center justify-content-between gap-2">
    <div class="d-flex flex-wrap align-items-center gap-3">
        <a class="btn-quaylai" asp-action="ChiTiet" asp-route-id="@tl.MaTaiLieu">
            ← Quay lại chi tiết
        </a>
        <div>
            <div class="fw-bold text-dark" style="font-size:1.05rem;">📕 @tl.TenTaiLieu</div>
            <div class="text-muted small">
                Định dạng: @dinhDang
                @if (!string.IsNullOrWhiteSpace(tl.TacGia)) { <span>• Tác giả: @tl.TacGia</span> }
                @if (!string.IsNullOrWhiteSpace(tl.DanhMuc)) { <span>• Thể loại: @tl.DanhMuc</span> }
            </div>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (Model.DaCoQuyenDoc)
        {
            <span class="btn-daquyen">✓ Đã có quyền đọc</span>
        }
        else
        {
            <span class="btn btn-sm btn-warning">Chưa có quyền đọc</span>
        }
        <a class="btn-tailieu" asp-action="Tai" asp-route-id="@tl.MaTaiLieu">
            ⬇ Tải tài liệu
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-3 col-md-4">
        <div class="info-card">
            <div class="info-title">
                <span>ℹ️</span> Thông Tin Tài Liệu
            </div>
            <div class="info-row">
                <span class="label">Tên tài liệu</span>
                <span class="value">@tl.TenTaiLieu</span>
            </div>
            <div class="info-row">
                <span class="label">Thể loại</span>
                <span class="value">@(tl.DanhMuc ?? "—")</span>
            </div>
            <div class="info-row">
                <span class="label">Tác giả</span>
                <span class="value">@(tl.TacGia ?? "—")</span>
            </div>
            <div class="info-row">
                <span class="label">Định dạng</span>
                <span class="value">@dinhDang</span>
            </div>
         
            @if (!string.IsNullOrWhiteSpace(tl.GhiChu))
            {
                <div class="info-mota">@tl.GhiChu</div>
            }
            else
            {
                <div class="info-mota">Tài liệu điện tử được cung cấp bởi Thư viện số trường Đại học Thủ Dầu Một.</div>
            }
        </div>
    </div>

    <div class="col-lg-9 col-md-8">
        <div class="viewer-wrap">
            <div class="viewer-bar">
                <span>☰</span>
                <span>@tl.MaTaiLieu</span>
            </div>

            @if (dinhDang == "PDF")
            {
                <embed src="@Model.UrlTaiNguyen" type="application/pdf" />
            }
            else if (dinhDang == "TXT")
            {
                <iframe src="@Model.UrlTaiNguyen"></iframe>
            }
            else if (dinhDang == "DOC" || dinhDang == "DOCX")
            {
                <div class="docx-scroll">
                    <div id="docxLoading" class="text-center text-muted py-4">
                        <div class="spinner-border spinner-border-sm text-light" role="status"></div>
                        <div class="mt-2">Đang tải nội dung tài liệu Word...</div>
                    </div>
                    <div id="docxContainer" class="docx-body"></div>
                </div>
            }
            else
            {
                <embed src="@Model.UrlTaiNguyen" />
            }

            <div class="watermark-layer" id="watermarkLayer"></div>
        </div>
    </div>
</div>

@section Scripts {
    @if (dinhDang == "DOC" || dinhDang == "DOCX")
    {
        <script src="~/lib/docx-preview/jszip.min.js"></script>
        <script src="~/lib/docx-preview/docx-preview.min.js"></script>
    }
    <script>
        (function () {
            var layer = document.getElementById('watermarkLayer');
            if (!layer) return;
            var text = '@tenNguoiDung • Mã tài liệu #@maTaiLieu • @thoiGian';
            var cols = 4, rows = 10;
            var html = '';
            for (var r = 0; r < rows; r++) {
                for (var c = 0; c < cols; c++) {
                    var left = (c * 100 / cols) + (r % 2 === 0 ? 0 : 12.5);
                    var top = (r * 100 / rows);
                    html += '<span class="wm-item" style="left:' + left + '%;top:' + top + '%;">' + text + '</span>';
                }
            }
            layer.innerHTML = html;
        })();

        (function () {
            var container = document.getElementById('docxContainer');
            if (!container || typeof docx === 'undefined') return;
            var loading = document.getElementById('docxLoading');

            fetch('@Model.UrlTaiNguyen')
                .then(function (res) {
                    if (!res.ok) throw new Error('Không tải được tệp tài liệu.');
                    return res.blob();
                })
                .then(function (blob) {
                    return docx.renderAsync(blob, container, null, {
                        className: 'docx-page',
                        inWrapper: true,
                        breakPages: true,
                        ignoreWidth: false,
                        ignoreHeight: false,
                        experimental: true
                    });
                })
                .then(function () {
                    if (loading) loading.style.display = 'none';
                })
                .catch(function (err) {
                    if (loading) {
                        loading.innerHTML = '<div class="alert alert-warning m-3">Không hiển thị được nội dung Word: '
                            + (err && err.message ? err.message : 'lỗi không xác định')
                            + '. Vui lòng dùng nút Tải tài liệu.</div>';
                    }
                });
        })();
    </script>
}
