@model TrangChuViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

<section class="home-welcome rounded-4 p-4 p-lg-5 mb-4">
    <div class="row align-items-center g-4">
        <div class="col">
            <span class="home-eyebrow">THƯ VIỆN SỐ · TDMU</span>
            <h1 class="display-6 fw-bold mt-2 mb-3">
                Chào mừng bạn đến với Hệ thống Thư viện số Trường Đại học Thủ Dầu Một
            </h1>
            <p class="text-secondary mb-4">
                Tra cứu sách, giáo trình và tài liệu học thuật trong kho thư viện của trường.
            </p>
            <form asp-controller="TaiLieu" asp-action="Index" method="get" class="home-search">
                <label class="visually-hidden" for="tuKhoaTrangChu">Tìm tài liệu</label>
                <input id="tuKhoaTrangChu" name="tuKhoa" class="form-control"
                       placeholder="Tìm theo tên tài liệu, tác giả hoặc nhà xuất bản..." />
                <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            </form>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <span class="small text-secondary align-self-center">Danh mục:</span>
                @foreach (var dm in Model.DanhSachDanhMuc.Take(5))
                {
                    <a class="badge rounded-pill text-bg-light border text-decoration-none"
                       asp-controller="TaiLieu" asp-action="Index" asp-route-danhMuc="@dm">@dm</a>
                }
            </div>
        </div>
    </div>
</section>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <div>
        <h2 class="h4 mb-1 fw-bold">Khám phá kho tài liệu</h2>
        <p class="text-secondary mb-0">Chọn loại tài liệu để bắt đầu tra cứu.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-primary" asp-controller="TaiLieu" asp-action="SachVatLi">Tra cứu sách vật lý</a>
        <a class="btn btn-primary" asp-controller="TaiLieu" asp-action="TaiLieuSo">Tra cứu tài liệu số</a>
    </div>
</div>

@if (Model.TaiLieuNoiBat.Count > 0)
{
    <section class="mt-5">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div>
                <h2 class="h4 mb-1 fw-bold">Tài liệu nổi bật</h2>
                <p class="text-secondary mb-0">Những tài liệu được bạn đọc xem nhiều nhất.</p>
            </div>
            <a class="btn btn-sm btn-outline-secondary" asp-controller="TaiLieu" asp-action="Index">Xem tất cả</a>
        </div>
        <div class="row g-3">
            @foreach (var tl in Model.TaiLieuNoiBat)
            {
                var laSach = tl.BanSach is not null;
                <div class="col-6 col-md-4 col-lg-3">
                    <a class="card h-100 shadow-sm border-0 overflow-hidden text-decoration-none text-reset"
                       asp-controller="TaiLieu" asp-action="ChiTiet" asp-route-id="@tl.MaTaiLieu">
                        <div class="d-flex align-items-center justify-content-center text-white position-relative"
                             style="background: linear-gradient(135deg, #0d4f8b, #1673c9); height: 150px;">
                            @if (!string.IsNullOrWhiteSpace(tl.DuongDanAnhBia))
                            {
                                <img src="@tl.DuongDanAnhBia" alt="Bìa tài liệu @tl.TenTaiLieu"
                                     class="w-100 h-100" style="object-fit: cover;" />
                            }
                            else
                            {
                                <i class="display-4 opacity-50">@(laSach ? "📚" : "📄")</i>
                            }
                            <span class="badge @(laSach ? "bg-light text-dark" : "text-bg-primary") position-absolute top-0 start-0 m-2">
                                @(laSach ? "SÁCH" : (tl.BanSo?.DinhDang?.ToUpper() ?? "TÀI LIỆU"))
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <div class="mb-1"><span class="badge bg-light text-secondary">@(tl.DanhMuc ?? "Chưa phân loại")</span></div>
                            <h6 class="card-title fw-semibold mb-1 text-truncate" title="@tl.TenTaiLieu">@tl.TenTaiLieu</h6>
                            <p class="card-text small text-muted mb-1">Tác giả: @(tl.TacGia ?? "—")</p>
                            <p class="card-text small text-muted mb-0"><i class="me-1">👁</i>@tl.SoLuotXem lượt xem</p>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
}
