@model TaiLenNckhViewModel
@{
    ViewData["Title"] = "Đóng góp tài liệu NCKH";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h3 class="mb-1">Đóng góp tài liệu nghiên cứu khoa học</h3>
                <p class="text-muted">
                    Tài liệu sau khi gửi sẽ ở trạng thái <span class="badge bg-warning text-dark">Chờ duyệt</span>
                    và chỉ xuất hiện trong kho tài liệu số sau khi được thủ thư kiểm duyệt.
                </p>

                <form asp-action="TaiLen" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                    <div class="mb-3">
                        <label asp-for="TenTaiLieu" class="form-label"></label>
                        <input asp-for="TenTaiLieu" class="form-control" />
                        <span asp-validation-for="TenTaiLieu" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="TacGia" class="form-label"></label>
                            <input asp-for="TacGia" class="form-control" />
                            <span asp-validation-for="TacGia" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DanhMuc" class="form-label"></label>
                            <input asp-for="DanhMuc" class="form-control" placeholder="Ví dụ: Bài báo NCKH" />
                            <span asp-validation-for="DanhMuc" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="NhaXuatBan" class="form-label"></label>
                            <input asp-for="NhaXuatBan" class="form-control" />
                            <span asp-validation-for="NhaXuatBan" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="NamXuatBan" class="form-label"></label>
                            <input asp-for="NamXuatBan" class="form-control" />
                            <span asp-validation-for="NamXuatBan" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TomTat" class="form-label"></label>
                        <textarea asp-for="TomTat" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="TomTat" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TepTaiLieu" class="form-label"></label>
                        <input asp-for="TepTaiLieu" type="file" class="form-control" accept=".pdf,.epub,.doc,.docx,.txt" />
                        <div class="form-text">Chấp nhận PDF, EPUB, DOC, DOCX, TXT. Dung lượng tối đa 25MB.</div>
                        <span asp-validation-for="TepTaiLieu" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="LaTaiLieuHanChe" class="form-check-input" />
                        <label asp-for="LaTaiLieuHanChe" class="form-check-label"></label>
                        <div class="form-text">Nếu chọn, độc giả khác cần được thủ thư phê duyệt mới đọc được toàn văn.</div>
                    </div>

                    <button type="submit" class="btn btn-primary">Gửi tài liệu</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
