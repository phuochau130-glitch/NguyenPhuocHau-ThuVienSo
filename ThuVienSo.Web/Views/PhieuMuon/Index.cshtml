@model List<PhieuMuon>
@{
    ViewData["Title"] = "Phiếu mượn của tôi";
}

<h3 class="mb-3">Phiếu mượn của tôi</h3>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Bạn chưa có phiếu mượn nào. Hãy tra cứu và đăng ký mượn sách vật lý.</div>
    <a class="btn btn-primary" asp-controller="TaiLieu" asp-action="Index">Tra cứu tài liệu</a>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white">
            <thead class="table-light">
                <tr>
                    <th>Mã phiếu</th>
                    <th>Tên sách</th>
                    <th>Ngày mượn</th>
                    <th>Thời hạn mượn</th>
                    <th>Hạn trả</th>
                    <th>Ngày trả</th>
                    <th>Trạng thái</th>
                    <th>Tiền phạt</th>
                    <th>Thủ thư xử lý</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.MaPhieu</td>
                        <td>@p.Sach.TaiLieu.TenTaiLieu</td>
                        <td>@p.NgayMuon.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(p.SoNgayMuon > 0 ? $"{p.SoNgayMuon} ngày" : "—")</td>
                        <td>@p.NgayPhaiTra.ToString("dd/MM/yyyy")</td>
                        <td>@HienThi.Ngay(p.NgayTraThucTe)</td>
                        <td><span class="badge @HienThi.LopTrangThai(p.TrangThai)">@p.TrangThai</span></td>
                        <td>@(p.TienPhat > 0 ? HienThi.Tien(p.TienPhat) : "—")</td>
                        <td>@(p.ThuThu?.NguoiDung.HoTen ?? "—")</td>
                        <td>
                            @if (p.TrangThai == TrangThaiPhieuMuon.ChoDuyet)
                            {
                                <form asp-action="Huy" method="post" onsubmit="return confirm('Bạn chắc chắn muốn hủy phiếu mượn này?');">
                                    <input type="hidden" name="maPhieu" value="@p.MaPhieu" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Hủy</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
