@model TaiLieu
@{
    var banSo = Model.BanSo;
    var dinhDangXem = banSo?.DinhDang?.ToUpperInvariant() ?? string.Empty;
    var laWord = dinhDangXem is "DOC" or "DOCX";
    var coTep = !string.IsNullOrWhiteSpace(banSo?.DuongDanFile);
    var urlXemTep = Url.Action("XemTep", "TaiLieuSo", new { area = "ThuThu", id = Model.MaTaiLieu });
}

<div class="row g-3">
    <div class="col-md-4">
        @if (!string.IsNullOrWhiteSpace(Model.DuongDanAnhBia))
        {
            <img src="@Model.DuongDanAnhBia" alt="Bìa tài liệu @Model.TenTaiLieu" class="img-fluid rounded border w-100" />
        }
        else
        {
            <div class="border rounded bg-light d-flex align-items-center justify-content-center text-muted"
                 style="height: 220px;">
                <span>Chưa có ảnh bìa</span>
            </div>
        }
    </div>

    <div class="col-md-8">
        <h5 class="fw-bold mb-2">@Model.TenTaiLieu</h5>
        <p class="mb-3">
            <span class="badge bg-primary">Tài liệu số</span>
            <span class="badge @(Model.LaTaiLieuHanChe ? "bg-warning text-dark" : "bg-secondary")">
                @(Model.LaTaiLieuHanChe ? "Giới hạn truy cập" : "Không giới hạn")
            </span>
            <span class="badge @HienThi.LopTrangThai(Model.TrangThaiDuyet)">@Model.TrangThaiDuyet</span>
        </p>

        <dl class="row mb-0 small">
            <dt class="col-sm-4">Mã tài liệu</dt>
            <dd class="col-sm-8">@Model.MaTaiLieu</dd>

            <dt class="col-sm-4">Tác giả</dt>
            <dd class="col-sm-8">@(Model.TacGia ?? "—")</dd>

            <dt class="col-sm-4">Nhà xuất bản</dt>
            <dd class="col-sm-8">@(Model.NhaXuatBan ?? "—")</dd>

            <dt class="col-sm-4">Năm xuất bản</dt>
            <dd class="col-sm-8">@(Model.NamXuatBan?.ToString() ?? "—")</dd>

            <dt class="col-sm-4">Danh mục</dt>
            <dd class="col-sm-8">@(Model.DanhMuc ?? "—")</dd>

            <dt class="col-sm-4">Định dạng</dt>
            <dd class="col-sm-8">@(banSo?.DinhDang ?? "—")</dd>

            <dt class="col-sm-4">Dung lượng</dt>
            <dd class="col-sm-8">@(banSo?.DungLuongFile.HasValue == true ? $"{banSo.DungLuongFile:0.##} MB" : "—")</dd>

            <dt class="col-sm-4">Lượt tải</dt>
            <dd class="col-sm-8">@(banSo?.SoLuotTai ?? 0)</dd>

            <dt class="col-sm-4">Lượt xem</dt>
            <dd class="col-sm-8">@Model.SoLuotXem</dd>
        </dl>

        @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
        {
            <hr />
            <p class="mb-2 small"><strong>Mô tả / ghi chú:</strong> @Model.GhiChu</p>
        }
    </div>
</div>

<hr />

<div class="d-flex justify-content-between align-items-center mb-2">
    <h6 class="fw-semibold mb-0">Xem trước nội dung</h6>
    @if (coTep)
    {
        <a class="btn btn-sm btn-outline-primary" href="@urlXemTep" target="_blank" rel="noopener">Mở tệp trong tab mới</a>
    }
</div>

@if (!coTep)
{
    <div class="alert alert-secondary mb-0 small">Tài liệu này chưa có tệp đính kèm.</div>
}
else if (laWord)
{
    <div data-docx-src="@urlXemTep" class="border rounded p-3" style="max-height:60vh;overflow:auto"></div>
}
else if (dinhDangXem == "PDF")
{
    <iframe src="@urlXemTep" title="Xem trước @Model.TenTaiLieu"
            style="width:100%;height:60vh;min-height:420px;border:1px solid #dee2e6;border-radius:.375rem"></iframe>
}
else
{
    <div class="alert alert-secondary mb-0 small">
        Trình duyệt không xem trước trực tiếp được định dạng @dinhDangXem.
        <a href="@urlXemTep" target="_blank" rel="noopener">Mở tệp</a>
    </div>
}

