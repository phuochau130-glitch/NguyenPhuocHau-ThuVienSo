@model BangDieuKhienThuThuViewModel
@{
    ViewData["Title"] = "Bảng điều khiển";
}

<h3 class="mb-1">Bảng điều khiển thủ thư</h3>
<p class="text-muted">Xin chào <strong>@User.TenHienThi()</strong>. Dưới đây là tổng quan công việc cần xử lý.</p>

@if (Model.TongViecCanXuLy == 0)
{
    <div class="alert alert-success">Hiện không có hồ sơ nào đang chờ xử lý. Bạn đã hoàn thành tốt công việc!</div>
}
else
{
    <div class="alert alert-warning">Có <strong>@Model.TongViecCanXuLy</strong> hồ sơ đang chờ bạn xử lý.</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm h-100 border-start border-4 border-warning">
            <div class="card-body">
                <div class="text-muted">Thẻ chờ duyệt</div>
                <div class="display-6 fw-bold text-warning">@Model.TheChoDuyet</div>
                <a class="btn btn-sm btn-outline-primary mt-2" asp-controller="TheThuVien" asp-action="Index"
                   asp-route-trangThai="@TrangThaiThe.ChoDuyet">Xét duyệt ngay</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm h-100 border-start border-4 border-warning">
            <div class="card-body">
                <div class="text-muted">Phiếu mượn chờ duyệt</div>
                <div class="display-6 fw-bold text-warning">@Model.PhieuChoDuyet</div>
                <a class="btn btn-sm btn-outline-primary mt-2" asp-controller="MuonTra" asp-action="Index"
                   asp-route-trangThai="@TrangThaiPhieuMuon.ChoDuyet">Duyệt phiếu</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm h-100 border-start border-4 border-warning">
            <div class="card-body">
                <div class="text-muted">Yêu cầu đọc chờ duyệt</div>
                <div class="display-6 fw-bold text-warning">@Model.YeuCauChoDuyet</div>
                <a class="btn btn-sm btn-outline-primary mt-2" asp-controller="YeuCau" asp-action="Index"
                   asp-route-trangThai="@TrangThaiYeuCau.ChoDuyet">Phê duyệt</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm h-100 border-start border-4 border-warning">
            <div class="card-body">
                <div class="text-muted">Tài liệu đóng góp chờ kiểm duyệt</div>
                <div class="display-6 fw-bold text-warning">@Model.TaiLieuChoKiemDuyet</div>
                <a class="btn btn-sm btn-outline-primary mt-2" asp-controller="KiemDuyet" asp-action="Index"
                   asp-route-trangThai="@TrangThaiDuyetTaiLieu.ChoDuyet">Kiểm duyệt</a>
            </div>
        </div>
    </div>
</div>

<h5 class="mb-3">Tình hình mượn trả</h5>
<div class="row g-3">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <span>Đang giữ sách (chờ nhận)</span>
                <span class="badge bg-warning text-dark fs-6">@Model.PhieuDangGiu</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <span>Đang mượn</span>
                <span class="badge bg-success fs-6">@Model.PhieuDangMuon</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <span>Quá hạn chưa trả</span>
                <span class="badge bg-danger fs-6">@Model.PhieuQuaHan</span>
            </div>
        </div>
    </div>
</div>

<h5 class="mb-3 mt-4">Thống kê tài liệu và sách vật lý</h5>
<div class="row g-3">
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Tổng lượt xem/đọc</div>
                <div class="fs-4 fw-bold text-primary">@Model.ThongKe.TongLuotXem</div>
                <div class="small text-muted mt-1">
                    Tài liệu số: @Model.ThongKe.LuotXemTaiLieuSo &middot; Sách vật lý: @Model.ThongKe.LuotXemSachVatLi
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Tổng lượt tải tài liệu số</div>
                <div class="fs-4 fw-bold text-primary">@Model.ThongKe.TongLuotTai</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Tổng lượt mượn sách</div>
                <div class="fs-4 fw-bold text-success">@Model.ThongKe.TongLuotMuon</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Lượt trả / Tổng tiền phạt</div>
                <div class="fs-4 fw-bold text-success">@Model.ThongKe.TongLuotTra</div>
                <div class="small text-danger mt-1">Phạt: @HienThi.Tien(Model.ThongKe.TongTienPhat)</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-3">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Tài liệu được mượn nhiều nhất</div>
            <ul class="list-group list-group-flush">
                @if (Model.ThongKe.SachMuonNhieuNhat.Count == 0)
                {
                    <li class="list-group-item text-muted">Chưa có dữ liệu.</li>
                }
                else
                {
                    @foreach (var s in Model.ThongKe.SachMuonNhieuNhat)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@s.TenSach</span>
                            <span class="badge bg-primary">@s.SoLuotMuon lượt</span>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Tài liệu được xem/đọc nhiều nhất</div>
            <ul class="list-group list-group-flush">
                @if (Model.ThongKe.TaiLieuXemNhieuNhat.Count == 0)
                {
                    <li class="list-group-item text-muted">Chưa có dữ liệu.</li>
                }
                else
                {
                    @foreach (var t in Model.ThongKe.TaiLieuXemNhieuNhat)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@t.TenTaiLieu <span class="text-muted small">(@t.LoaiTaiLieu)</span></span>
                            <span class="badge bg-secondary">@t.SoLuotXem lượt</span>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
</div>
