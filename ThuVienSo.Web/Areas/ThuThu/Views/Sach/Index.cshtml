@model List<TaiLieu>
@{
    ViewData["Title"] = "Quản lý sách vật lý";
    var tuKhoaHienTai = (string?)ViewBag.TuKhoa;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h3 class="mb-0">Quản lý sách vật lý</h3>
    <a class="btn btn-primary" asp-action="Them">+ Thêm sách mới</a>
</div>

<form method="get" class="card shadow-sm mb-4">
    <div class="card-body row g-2">
        <div class="col-md-6">
            <input name="tuKhoa" value="@tuKhoaHienTai" class="form-control"
                   placeholder="Tìm theo mã sách, tên sách hoặc tác giả..." />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(tuKhoaHienTai))
        {
            <div class="col-md-2">
                <a class="btn btn-outline-secondary w-100" asp-action="Index">Xóa lọc</a>
            </div>
        }
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-warning">Không có sách vật lý nào phù hợp với điều kiện tìm kiếm.</div>
}
else
{
    <p class="text-muted">Có <strong>@Model.Count</strong> đầu sách vật lý trong kho.</p>
    <div class="table-responsive">
        <table class="table table-hover align-middle bg-white">
            <thead class="table-light">
                <tr>
                    <th>Mã sách</th>
                    <th>Tên sách</th>
                    <th>Tác giả</th>
                    <th>NXB / Năm</th>
                    <th>Vị trí kệ</th>
                    <th>Số lượng (khả dụng / tổng)</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tl in Model)
                {
                    var sach = tl.BanSach!;
                    <tr>
                        <td class="fw-semibold">@tl.MaTaiLieu</td>
                        <td>
                            @tl.TenTaiLieu
                            @if (!string.IsNullOrWhiteSpace(tl.DanhMuc))
                            {
                                <br />
                                <small class="text-muted">@tl.DanhMuc</small>
                            }
                        </td>
                        <td>@(tl.TacGia ?? "—")</td>
                        <td>
                            @(tl.NhaXuatBan ?? "—")
                            @if (tl.NamXuatBan.HasValue)
                            {
                                <br />
                                <small class="text-muted">@tl.NamXuatBan</small>
                            }
                        </td>
                        <td>@(sach.ViTriKeSach ?? "—")</td>
                        <td>
                            <span class="badge @(sach.SoLuongKhaDung > 0 ? "bg-success" : "bg-danger") fs-6">
                                @sach.SoLuongKhaDung / @sach.TongSoLuong
                            </span>
                            @if (sach.SoLuongKhaDung == 0)
                            {
                                <br />
                                <small class="text-danger">Hết bản khả dụng</small>
                            }
                            @{
                                var soChuaNhan = sach.DanhSachPhieuMuon.Count(p => p.TrangThai == TrangThaiPhieuMuon.ChuaNhan);
                            }
                            @if (soChuaNhan > 0)
                            {
                                <br />
                                <span class="badge bg-danger">Chưa nhận sách: @soChuaNhan</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        data-xem-tai-lieu="@Url.Action("Xem", new { id = tl.MaTaiLieu })">Xem</button>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Sua" asp-route-id="@tl.MaTaiLieu">Sửa</a>
                                <form asp-action="Xoa" method="post"
                                      onsubmit="return confirm('Bạn chắc chắn muốn xóa sách này khỏi kho?');">
                                    <input type="hidden" name="maSach" value="@tl.MaTaiLieu" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <partial name="_ModalXem" />
}
