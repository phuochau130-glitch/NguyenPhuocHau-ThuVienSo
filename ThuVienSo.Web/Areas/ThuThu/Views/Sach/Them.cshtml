@model SachVatLiFormViewModel
@{
    ViewData["Title"] = "Thêm sách vật lý";
}

<h3 class="mb-3">Thêm sách vật lý vào kho</h3>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Them" method="post" enctype="multipart/form-data">
            <partial name="_FormSach" model="Model" />
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Thêm sách</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}