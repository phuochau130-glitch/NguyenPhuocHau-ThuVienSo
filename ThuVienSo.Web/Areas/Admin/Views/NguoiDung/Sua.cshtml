@model SuaNguoiDungViewModel
@{
    ViewData["Title"] = "Sửa tài khoản";
}

<h3 class="mb-3">Sửa tài khoản @Model.MaNguoiDung</h3>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Sua" method="post">
            <input type="hidden" asp-for="MaNguoiDung" />
            <input type="hidden" asp-for="VaiTro" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Vai trò</label>
                    <input class="form-control" value="@VaiTro.TenHienThi(Model.VaiTro)" disabled />
                </div>
                <div class="col-md-6">
                    <label asp-for="HoTen" class="form-label"></label>
                    <input asp-for="HoTen" class="form-control" />
                    <span asp-validation-for="HoTen" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SoDienThoai" class="form-label"></label>
                    <input asp-for="SoDienThoai" class="form-control" />
                    <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                </div>
                @if (Model.VaiTro is VaiTro.SinhVien or VaiTro.GiangVien)
                {
                    <div class="col-md-6">
                        <label asp-for="MaSinhVienHoacCanBo" class="form-label"></label>
                        <input asp-for="MaSinhVienHoacCanBo" class="form-control" />
                        <span asp-validation-for="MaSinhVienHoacCanBo" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Khoa" class="form-label"></label>
                        <input asp-for="Khoa" class="form-control" />
                        <span asp-validation-for="Khoa" class="text-danger"></span>
                    </div>
                }
                else if (Model.VaiTro == VaiTro.ThuThu)
                {
                    <div class="col-md-6">
                        <label asp-for="MaNhanVien" class="form-label"></label>
                        <input asp-for="MaNhanVien" class="form-control" />
                        <span asp-validation-for="MaNhanVien" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BoPhan" class="form-label"></label>
                        <input asp-for="BoPhan" class="form-control" />
                        <span asp-validation-for="BoPhan" class="text-danger"></span>
                    </div>
                }
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
